# ---------------------------------------------------------------
# SECRETS — must never be committed (enforced by tests/test_data_rules.py
# via `git check-ignore`, and by the gitleaks pre-commit hook)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*service-account*.json
*service_account*.json
credentials*
!**/credentials_example*

# ---------------------------------------------------------------
# Data and run products (large, regenerable, may contain licensed data)
# ---------------------------------------------------------------
cache/
outputs/
logs/
validation/data/
# training data (Sen1Floods11 chips): downloaded by scripts/fetch_sen1floods11.py, never committed
data/
# training checkpoints (the shipped model is the small .onnx file)
models/**/*.pt
*.tif
*.tiff
!tests/fixtures/**/*.tif

# Organizer documents — do not redistribute
docs/*.pdf

# ---------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# segmentation model candidates (only the adopted model is committed)
models/segmentation/candidates/

# Local AI-assistant working notes (kept on the maintainer's machine only)
CLAUDE.md
.claude/
# Local working files (build log and submission notes; kept on the author's machine)
PLAN.md
docs/devpost.md
report/video/video_script.md
outputs_archive/
