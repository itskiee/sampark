# Store text files with LF line endings in the repository and working tree on every OS,
# so Windows and Linux (CI, judges) see byte-identical files.
* text=auto eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.tif binary
*.tiff binary
*.gpkg binary
*.zip binary
